<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <!--
    NKeeper's SDK, plugin build and test packages come from GitHub Packages, which needs a token even to read.
    The credentials come from the environment, never from this file: set NUGET_USERNAME to your GitHub user name
    and NUGET_TOKEN to a token that can read packages (CI uses github.actor and the workflow's token).
    LOCAL_FEED, when set, is a folder of packages built from NKeeper's feature branches; it takes the place of
    GitHub Packages for NKeeper's own packages.
  -->
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
    <add key="github" value="https://nuget.pkg.github.com/OpenCraft-Solutions/index.json" />
  </packageSources>

  <packageSourceCredentials>
    <github>
      <add key="Username" value="%NUGET_USERNAME%" />
      <add key="ClearTextPassword" value="%NUGET_TOKEN%" />
    </github>
  </packageSourceCredentials>

  <!-- Only NKeeper's packages may come from GitHub Packages, and nothing of NKeeper's from anywhere else. -->
  <packageSourceMapping>
    <packageSource key="github">
      <package pattern="NKeeper.Abstractions" />
      <package pattern="NKeeper.Plugin.Build" />
      <package pattern="NKeeper.Testing" />
    </packageSource>
    <packageSource key="nuget.org">
      <package pattern="*" />
    </packageSource>
  </packageSourceMapping>
</configuration>
